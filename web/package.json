{
  "name": "lv-register-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Frontend of lv-register: React + TypeScript (Vite), shadcn/ui, TanStack Query, d3.js. Talks only to the API.",
  "scripts": {
    "dev": "vite",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "build": "npm run gen:api && tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run gen:api && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@tanstack/react-query": "5.105.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.1",
    "d3": "7.9.0",
    "lucide-react": "1.66.0",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "react-router": "8.5.1",
    "recharts": "3.10.1",
    "shadcn": "4.23.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/d3": "7.4.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
