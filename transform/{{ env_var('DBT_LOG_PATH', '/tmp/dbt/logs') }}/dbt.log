  create view "fixtures"."main"."stg_beneficial_owners__dbt_tmp" as (
    -- Several nationalities are listed as LV;US inside one field (source assessment 9).
select
    capture_date,
    case when regexp_full_match(nullif(trim(regexp_replace(nfc_normalize(legal_entity_registration_number), '[ \t\n\x0B\f\r\x{00A0}\x{2007}\x{202F}]+', ' ', 'g')), ''), '\d{9}|\d{11}') then nullif(trim(regexp_replace(nfc_normalize(legal_entity_registration_number), '[ \t\n\x0B\f\r\x{00A0}\x{2007}\x{202F}]+', ' ', 'g')), '') end as company_reg_number,
    nullif(trim(regexp_replace(nfc_normalize(coalesce(nullif(trim(regexp_replace(nfc_normalize(forename), '[ \t\n\x0B\f\r\x{00A0}\x{2007}\x{202F}]+', ' ', 'g')), ''), '') || ' ' || coalesce(nullif(trim(regexp_replace(nfc_normalize(surname), '[ \t\n\x0B\f\r\x{00A0}\x{2007}\x{202F}]+', ' ', 'g')), ''), '')), '[ \t\n\x0B\f\r\x{00A0}\x{2007}\x{202F}]+', ' ', 'g')), '') as name,
    nullif(trim(regexp_replace(nfc_normalize(latvian_identity_number_masked), '[ \t\n\x0B\f\r\x{00A0}\x{2007}\x{202F}]+', ' ', 'g')), '') as masked_code,
    nullif(trim(regexp_replace(nfc_normalize(birth_date), '[ \t\n\x0B\f\r\x{00A0}\x{2007}\x{202F}]+', ' ', 'g')), '') as birth_date,
    list_sort(list_distinct(list_filter(
        list_transform(string_split(coalesce(upper(nullif(trim(regexp_replace(nfc_normalize(nationality), '[ \t\n\x0B\f\r\x{00A0}\x{2007}\x{202F}]+', ' ', 'g')), '')), ''), ';'), x -> trim(x)),
        x -> regexp_full_match(x, '[A-Z]{2}')))) as nationalities,
    case when regexp_full_match(upper(nullif(trim(regexp_replace(nfc_normalize(residence), '[ \t\n\x0B\f\r\x{00A0}\x{2007}\x{202F}]+', ' ', 'g')), '')), '[A-Z]{2}') then upper(nullif(trim(regexp_replace(nfc_normalize(residence), '[ \t\n\x0B\f\r\x{00A0}\x{2007}\x{202F}]+', ' ', 'g')), '')) end as residence,
    try_cast(nullif(trim(regexp_replace(nfc_normalize(registered_on), '[ \t\n\x0B\f\r\x{00A0}\x{2007}\x{202F}]+', ' ', 'g')), '') as date) as since
from (select * exclude (date), cast(date as date) as capture_date
 from read_parquet('{ env_var('LV_LAKE_ROOT', 's3://lv-lake') }/beneficial_owners/*/beneficial_owners.parquet',
                   hive_partitioning = true, file_row_number = true, union_by_name = true))
  );

