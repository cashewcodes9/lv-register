# Copy to .env and adjust. Compose reads .env if present; every value here has a default.
# These are local development values only. Never put real credentials in this file.

# S3 (SeaweedFS `lake` service). Keys must match docker/seaweedfs/s3.json.
S3_ENDPOINT=http://lake:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=lvdev
S3_SECRET_KEY=lvdev-local-only-secret
S3_BUCKET_RAW=lv-raw
S3_BUCKET_LAKE=lv-lake
S3_BUCKET_MARTS=lv-marts

# PostgreSQL (`postgres` service). Passwords are read only when the data volume is created;
# after a change, recreate the volume (`docker compose down -v` deletes all data).
POSTGRES_PASSWORD=postgres-local-only
SERVING_DB_PASSWORD=lv-serving-local-only
DAGSTER_DB_PASSWORD=dagster-local-only

# Serving store (PLAN.md section 4): the adapter behind the `serving` port.
SERVING_BACKEND=postgres
SERVING_JDBC_URL=jdbc:postgresql://postgres:5432/lv_serving
SERVING_DB_USER=lv_serving

# Retention (PLAN.md section 6.2): captures kept per layer, and the storage warning level.
RAW_KEEP=2
LAKE_KEEP=12
STORAGE_WARN_GB=10

# Log level of the CLI (logback.xml)
LOG_LEVEL=INFO
