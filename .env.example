# Copy to .env and adjust. Compose reads .env if present; every value here has a default.
# These are local development values only. Never put real credentials in this file.

# S3 (SeaweedFS `lake` service). Keys must match docker/seaweedfs/s3.json.
S3_ENDPOINT=http://lake:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=lvdev
S3_SECRET_KEY=lvdev-local-only-secret
S3_BUCKET_RAW=lv-raw
S3_BUCKET_LAKE=lv-lake
S3_BUCKET_MARTS=lv-marts

# PostgreSQL (`postgres` service). Passwords are read only when the data volume is created;
# after a change, recreate the volume (`docker compose down -v` deletes all data).
POSTGRES_PASSWORD=postgres-local-only
SERVING_DB_PASSWORD=lv-serving-local-only
DAGSTER_DB_PASSWORD=dagster-local-only

# Serving store (PLAN.md section 4): the adapter behind the `serving` port.
SERVING_BACKEND=postgres
SERVING_JDBC_URL=jdbc:postgresql://postgres:5432/lv_serving
SERVING_DB_USER=lv_serving

# Quality report warning levels (starting values, tuned on real captures).
QUALITY_DROP_SHARE=0.01
QUALITY_ROW_CHANGE_SHARE=0.05
QUALITY_EVENT_SPIKE_SHARE=0.01
QUALITY_EVENT_SPIKE_MIN=500
# Events of one type per company above which the event_spike check blocks the capture.
QUALITY_EVENT_HARD_SHARE=0.10

# Retention (PLAN.md section 6.2): captures kept per layer, and the storage warning level.
RAW_KEEP=2
LAKE_KEEP=12
STORAGE_WARN_GB=10

# DuckDB in the lake step: memory limit before spilling to disk, threads.
DUCKDB_MEMORY_LIMIT=1GB
DUCKDB_THREADS=1

# JVM options of the cli container (diff holds two snapshots: about 2 GB heap).
CLI_JAVA_OPTS=-Xmx2g -XX:+UseSerialGC

# Log level of the CLI (logback.xml)
LOG_LEVEL=INFO

# Dagster (profile orchestration). Weekly capture schedule (cron, Europe/Riga), optional
# webhook for failed runs (JSON {"text": ...}), and how long Dagster keeps its run history.
LV_CAPTURE_CRON=0 6 * * 1
LV_ALERT_WEBHOOK_URL=
DAGSTER_RUN_RETENTION_DAYS=90

# Read API (`api` service, profile core): rate limit per client IP, CORS origin of the Vite dev
# server, JVM options, limits of the company network graph.
API_RATE_LIMIT_PER_MINUTE=120
API_RATE_LIMIT_BURST=30
API_CORS_ORIGINS=http://localhost:5173
API_JAVA_OPTS=-Xmx256m -XX:+UseSerialGC
API_NETWORK_MAX_COMPANIES=30
API_NETWORK_MAX_NODES=300
